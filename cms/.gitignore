# Dependencies
**/node_modules/

# Environment secrets — never commit real credentials
backend/.env

# Backend runtime data
backend/logs/*
!backend/logs/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Frontend build output
frontend/dist/
frontend/.angular/

# Capacitor native builds (regenerated by `cap add android`, not hand-edited)
mobile/*/android/
mobile/*/ios/

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
